# ==============================================================================
# Chessing - Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.
# NOTE: Do NOT commit '.env' with real credentials to version control!
# ==============================================================================

# Supabase Configuration
# Found in: Supabase Console -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Sign-In Configuration
# Found in: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web Client)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Optional: Google Gemini API Key for AI Coaching
# Can also be entered directly in the App via Settings -> AI & Coaching
GEMINI_API_KEY=your-gemini-api-key
